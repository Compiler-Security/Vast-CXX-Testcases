import os

config.my_src_root = r"@CMAKE_SOURCE_DIR@"
config.my_obj_root = r"@CMAKE_BINARY_DIR@"

config.vast_path = "@VAST_PATH@"
config.vast_target = "@VAST_TARGET@"

config.test_db = @TEST_DB@
config.clean_db = @CLEAN_DB@
config.neo4j_user = "@NEO4J_USER@"
config.neo4j_password = "@NEO4J_PASSWORD@"
config.neo4j_address = "@NEO4J_ADDRESS@"
config.neo4j_database = "@NEO4J_DATABASE@"
config.neo4j_uid_alloc_size = "@NEO4J_UID_ALLOC_SIZE@"

import lit.llvm
lit.llvm.initialize(lit_config, config)

lit_config.load_config(
    config, os.path.join(config.my_src_root, "lit.cfg.py")
)
